{
  "name": "@wingman/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint entrypoints src",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node tests/e2e-mock.mjs && node tests/e2e-suggest.mjs"
  },
  "dependencies": {
    "@wingman/core": "workspace:*",
    "@wingman/platform-adapters": "workspace:*",
    "@wingman/api-client": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "playwright": "1.63.0",
    "vitest": "^3.2.7",
    "wxt": "^0.21.0",
    "fake-indexeddb": "^6.2.7"
  }
}
