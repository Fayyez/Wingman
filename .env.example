# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://wingman:wingman@localhost:5432/wingman
REDIS_URL=redis://localhost:6379/0

# LLM providers (any subset; the gateway routes by config)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embedding bake-off (optional)
VOYAGE_API_KEY=

# Auth (M1)
GOOGLE_CLIENT_ID=
JWT_PRIVATE_KEY=

# Observability (local Langfuse from docker compose)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
